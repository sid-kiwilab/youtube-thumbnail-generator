# Setup: https://github.com/sid-kiwilab/youtube-thumbnail-generator/blob/main/docs/setup.md
# Minimum: YOUTUBE_API_KEY to load channel + niche search

# Google Cloud → YouTube Data API v3 → API key (see docs/setup.md)
YOUTUBE_API_KEY=

# openrouter.ai — titles + vision eval (optional until you click Suggest / Vision)
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_NICHE_MODEL=anthropic/claude-sonnet-4.5

# platform.openai.com — thumbnail image edits only (optional until Generate thumbnail)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst